      },
      "info": {
        "light": "#2F6FED",
        "dark": "#5B8DEF"
      },
      "focus_ring": {
        "light": "#2F6FED",
        "dark": "#7AA4F2"
      }
    },
    "typography": {
      "families": {
        "sans": "Inter, system-ui, -apple-system, Segoe UI, Roboto, sans-serif"
      },
      "scale": {
        "xs": 12,
        "sm": 14,
        "base": 16,
        "lg": 18,
        "xl": 20,
        "2xl": 24,
        "3xl": 30,
        "4xl": 36
      },
      "weights": {
        "regular": 400,
        "medium": 500,
        "semibold": 600
      },
      "line_heights": {
        "body": 1.5,
        "heading": 1.2
      },
      "reading_measure_ch": 70,
      "numerics": "tabular figures in tables and metrics"
    },
    "spacing": {
      "base": 8,
      "scale": {
        "1": 4,
        "2": 8,
        "3": 12,
        "4": 16,
        "6": 24,
        "8": 32,
        "12": 48,
        "16": 64
      }
    },
    "radius": {
      "sm": 4,
      "md": 8,
      "lg": 12,
      "full": 9999
    },
    "elevation": {
      "sm": "0 1px 2px rgba(16,24,40,0.06), 0 1px 3px rgba(16,24,40,0.10)",
      "md": "0 4px 8px rgba(16,24,40,0.08), 0 2px 4px rgba(16,24,40,0.06)",
      "lg": "0 12px 24px rgba(16,24,40,0.12), 0 4px 8px rgba(16,24,40,0.08)",
      "dark_note": "In dark mode express elevation via lighter surfaces rather than shadow."
    },
    "motion": {
      "durations": {
        "fast": "120ms",
        "base": "200ms",
        "slow": "320ms"
      },
      "easings": {
        "out": "cubic-bezier(0.2, 0, 0, 1)",
        "in_out": "cubic-bezier(0.4, 0, 0.2, 1)"
      },
      "reduced_motion": "Under prefers-reduced-motion, drop decorative transitions; keep state-change feedback instantaneous."
    }
  },
  "responsive": {
    "breakpoints": {
      "sm": 640,
      "md": 768,
      "lg": 1024,
      "xl": 1280
    },
    "container_widths": {
      "content": 760,
      "app": "fluid with 240px sidebar"
    },
    "density": [
      "comfortable",
      "compact"
    ]
  },
  "acceptance_criteria": [
    {
      "id": "AC-001",
      "screen_id": "SCR-001",
      "flow_id": "FLOW-001",
      "requirement_ids": [
        "REQ-001"
      ],
      "statement": "Requester can start a new request from the dashboard using a clearly labeled primary action.",
      "priority": "must"
    },
    {
      "id": "AC-002",
      "screen_id": "SCR-002",
      "flow_id": "FLOW-001",
      "requirement_ids": [
        "REQ-001"
      ],
      "statement": "If required fields are blank, inline errors appear and focus moves to the error summary.",
      "priority": "must"
    },
    {
      "id": "AC-003",
      "screen_id": "SCR-003",
      "flow_id": "FLOW-001",
      "requirement_ids": [
        "REQ-002"
      ],
      "statement": "Requester can review all entered details and edit any section before submission.",
      "priority": "must"
    },
    {
      "id": "AC-004",
      "screen_id": "SCR-004",
      "flow_id": "FLOW-001",
      "requirement_ids": [
        "REQ-001",
        "REQ-002"
      ],
      "statement": "After successful submission, requester sees a confirmation number and next actions.",
      "priority": "must"
    }
  ]
}
