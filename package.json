{
  "name": "primesoft-hrms",
  "version": "0.1.0",
  "private": true,
  "description": "PrimeSoft HRMS modular-monolith foundation services.",
  "scripts": {
    "typecheck": "npx tsc -p tsconfig.json --noEmit",
    "build": "npx tsc -p tsconfig.json",
    "test": "npm run build && node --test apps/api/test/*.test.cjs",
    "check": "npm run typecheck && npm test",
    "web:typecheck": "npx tsc -p apps/web/tsconfig.json --noEmit",
    "web:build": "node node_modules/vite/bin/vite.js build --config apps/web/vite.config.ts",
    "web:test": "node --test apps/web/test/*.test.cjs",
    "web:test:e2e": "node tools/e2e-preflight.mjs && playwright test --config apps/web/playwright.config.ts",
    "web:check": "npm run web:typecheck && npm run web:build && npm run web:test",
    "web:dev": "node node_modules/vite/bin/vite.js --config apps/web/vite.config.ts --host 127.0.0.1"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.15",
    "@types/pg": "^8.20.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "3.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.55.1",
    "@tailwindcss/postcss": "4.1.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "postcss": "8.5.17",
    "tailwindcss": "4.1.14",
    "typescript": "5.7.3",
    "vite": "^8.1.2"
  }
}
