| display_self_rating | boolean | Y | Show self rating. | TRUE |
| display_manager_rating | boolean | Y | Show manager rating. | TRUE |
| display_skip_level_rating | boolean | Y | Show skip-level. | FALSE |
| display_peer_average | boolean | Y | Show peer avg. | FALSE |
| display_360_summary | boolean | Y | Show 360 summary. | FALSE |
| display_goal_progress | boolean | Y | Show goal progress. | TRUE |
