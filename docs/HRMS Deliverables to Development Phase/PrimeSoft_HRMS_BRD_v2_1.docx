| custom_field_id | uuid | N | If field_code=CUSTOM. FK → custom_fields.id. | NULL |
| field_display_label | string(120) | N | Tenant-specific label override. | NULL |
| is_visible | boolean | Y | Show in form. | TRUE |
| is_editable | boolean | Y | Permit editing. | TRUE |
| is_mandatory | boolean | Y | Required on save. | FALSE |
| persona_visibility | jsonb | Y | Per-persona toggles (EMPLOYEE, MANAGER, HRBP, ADMIN). | {EMPLOYEE: true, MANAGER: true, HRBP: true, ADMIN: true} |
| persona_editability | jsonb | Y | Per-persona edit toggles. | {EMPLOYEE: true, MANAGER: true, HRBP: false, ADMIN: true} |
| validation_rule | string(500) | N | PCRE regex or expression. | NULL |
| help_text | string(500) | N | Tooltip. | NULL |
| sort_order | integer | Y | Display order in form. | 1 |

