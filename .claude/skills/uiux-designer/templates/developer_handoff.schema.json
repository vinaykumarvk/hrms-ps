{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "uiux-developer-handoff.schema.json",
  "title": "UI/UX Developer Handoff",
  "type": "object",
  "required": [
    "version",
    "product",
    "scope",
    "platforms",
    "roles",
    "requirements",
    "flows",
    "screens",
    "components",
    "global_accessibility",
    "acceptance_criteria"
  ],
  "properties": {
    "version": {
      "type": "string",
      "description": "Handoff schema version, for example uiux-handoff.v1"
    },
    "product": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "impact"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "question",
          "impact",
          "owner"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          }
        }
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "goals",
          "permissions"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "goals": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "summary",
          "type",
          "priority"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "priority": {
            "enum": [
              "must",
              "should",
              "could",
              "wont",
              "unknown"
            ]
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "actor_role_id",
          "trigger",
          "entry_screen_id",
          "steps"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "actor_role_id": {
            "type": "string"
          },
          "trigger": {
            "type": "string"
          },
          "entry_screen_id": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "order",
                "screen_id",
                "user_action",
                "system_response",
                "next_screen_id",
                "requirement_ids"
              ],
              "properties": {
                "order": {
                  "type": "integer"
                },
                "screen_id": {
                  "type": "string"
                },
                "user_action": {
                  "type": "string"
                },
                "system_response": {
                  "type": "string"
                },
                "next_screen_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "requirement_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "alternate_paths": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "exception_paths": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "exit_criteria": {
            "type": "string"
          }
        }
      }
    },
    "screens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "purpose",
          "user_goal",
          "entry_points",
          "exit_points",
          "primary_action",
          "components",
          "states",
          "accessibility",
          "requirement_ids",
          "acceptance_criteria"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "user_goal": {
            "type": "string"
          },
          "entry_points": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exit_points": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "layout_summary": {
            "type": "string"
          },
          "primary_action": {
            "type": "object"
          },
          "secondary_actions": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "components": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "content": {
            "type": "object"
          },
          "data_inputs": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "data_outputs": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "validations": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "states": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "accessibility": {
            "type": "object"
          },
          "visual": {
            "type": "object",
            "description": "Visual intent for this screen.",
            "properties": {
              "hierarchy": {
                "type": "string",
                "description": "What the eye should hit 1st/2nd/3rd."
              },
              "emphasis_tokens": {
                "type": "string",
                "description": "Key token usage: surface, accent, emphasis."
              },
              "density": {
                "type": "string"
              }
            },
            "additionalProperties": true
          },
          "motion": {
            "type": "object",
            "description": "Motion and micro-interaction intent for this screen.",
            "properties": {
              "transitions": {
                "type": "string",
                "description": "Meaningful transitions/feedback on this screen."
              },
              "loading_treatment": {
                "type": "string",
                "description": "e.g. skeleton, optimistic UI, spinner."
              },
              "reduced_motion": {
                "type": "string",
                "description": "Behavior under prefers-reduced-motion."
              }
            },
            "additionalProperties": true
          },
          "analytics_events": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "api_or_data_dependencies": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "type",
          "used_on_screen_ids",
          "states",
          "accessibility_notes"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "used_on_screen_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "variants": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "states": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "accessibility_notes": {
            "type": "string"
          }
        }
      }
    },
    "global_accessibility": {
      "type": "object",
      "required": [
        "standard",
        "keyboard",
        "focus",
        "color_contrast",
        "screen_reader",
        "touch_targets",
        "error_handling"
      ],
      "properties": {
        "standard": {
          "type": "string"
        },
        "keyboard": {
          "type": "string"
        },
        "focus": {
          "type": "string"
        },
        "color_contrast": {
          "type": "string"
        },
        "screen_reader": {
          "type": "string"
        },
        "touch_targets": {
          "type": "string"
        },
        "error_handling": {
          "type": "string"
        }
      }
    },
    "analytics_events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "trigger",
          "properties"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "trigger": {
            "type": "string"
          },
          "properties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "design_system": {
      "type": "object",
      "description": "Design-token contract between design and development. Optional but expected for any user-facing, visually-designed deliverable.",
      "properties": {
        "aesthetic_direction": {
          "type": "string",
          "description": "e.g. functional minimal, soft/friendly, editorial, dense/professional, elevated/premium, expressive/bold, plus a one-line rationale."
        },
        "color": {
          "type": "object",
          "description": "Color roles with light and (where relevant) dark values. Keys are role names like bg, surface, surface_raised, text, text_muted, primary, primary_hover, on_primary, success, warning, danger, info, border, focus_ring.",
          "additionalProperties": true
        },
        "typography": {
          "type": "object",
          "description": "families, scale (named size steps), weights, line_heights, reading_measure.",
          "additionalProperties": true
        },
        "spacing": {
          "type": "object",
          "description": "base unit and named scale steps; e.g. base: 8, scale: {1:4,2:8,4:16,...}.",
          "additionalProperties": true
        },
        "radius": {
          "type": "object",
          "additionalProperties": true,
          "description": "named radius steps."
        },
        "elevation": {
          "type": "object",
          "additionalProperties": true,
          "description": "named shadow/elevation tokens."
        },
        "motion": {
          "type": "object",
          "description": "durations, easings, and reduced_motion handling.",
          "additionalProperties": true
        },
        "themes": {
          "type": "array",
          "description": "Supported themes, e.g. ['light','dark'].",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "responsive": {
      "type": "object",
      "description": "Responsive system: breakpoints, container widths, and density modes.",
      "properties": {
        "breakpoints": {
          "type": "object",
          "additionalProperties": true,
          "description": "e.g. {sm:640, md:768, lg:1024, xl:1280}."
        },
        "container_widths": {
          "type": "object",
          "additionalProperties": true
        },
        "density": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "e.g. ['comfortable','compact']."
        }
      },
      "additionalProperties": true
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "priority"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "flow_id": {
            "type": "string"
          },
          "screen_id": {
            "type": "string"
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "statement": {
            "type": "string"
          },
          "priority": {
            "enum": [
              "must",
              "should",
              "could"
            ]
          }
        }
      }
    }
  },
  "additionalProperties": true
}
