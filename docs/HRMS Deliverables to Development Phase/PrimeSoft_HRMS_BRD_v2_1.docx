| display_leave_summary | boolean | Y | Show leave summary. | FALSE |
| display_promotion_eligibility | boolean | Y | Show promotion flag. | FALSE |
| display_compensation_band | boolean | Y | Show comp band (sensitive). | FALSE |
| display_tenure | boolean | Y | Show tenure. | TRUE |
| display_previous_cycle_rating | boolean | Y | Show prior rating. | TRUE |
| display_comparison_with_peers | boolean | Y | Show peer comparison. | FALSE |
